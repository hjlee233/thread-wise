# Thread Wise 서버 환경변수 예시
# 실제 값은 .env 파일에 넣고, .env 는 절대 커밋하지 않는다.

# OpenAI API Key. 서버에서만 보관한다. Extension 코드에는 절대 포함하지 않는다.
OPENAI_API_KEY=sk-your-key-here

# 사용할 OpenAI 모델. Responses API + Structured Outputs 를 지원하는 모델을 사용한다.
OPENAI_MODEL=gpt-4.1-mini

# OpenAI 요청 타임아웃(ms)
OPENAI_TIMEOUT_MS=30000

# 서버 포트
PORT=3000

# 실행 환경: development | production
NODE_ENV=development

# 게시글 본문 최대 길이(문자). 초과분은 서버에서 잘라내고 경고를 남긴다.
MAX_BODY_CHARS=12000

# CORS 허용 Origin 목록. 콤마로 구분.
# - development: 비우면 모든 origin 을 허용한다(개발 편의).
# - production: 비워두면 서버가 기동을 거부한다(보안 가드). 반드시 명시할 것.
# 예: chrome-extension://abcdefghijklmnopabcdefghijklmnop
CORS_ALLOWED_ORIGINS=
